---
interface Props {
	date: Date;
	// "by <date>": the date is a ceiling, not the day it went up.
	ceiling?: boolean;
}

const { date, ceiling = false } = Astro.props;
---

<span>{ceiling && 'by '}<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time></span>
