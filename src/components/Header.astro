---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const links = [
	{ href: '/', text: 'Posts', active: path === '/' || path.startsWith('/blog/') },
	{ href: '/archive', text: 'Archive', active: path.startsWith('/archive') },
	{ href: '/about', text: 'About', active: path.startsWith('/about') },
	{ href: '/rss.xml', text: 'RSS', active: false },
];
---

<header class="site-header">
	<div class="container inner">
		<a class="wordmark" href="/">{SITE_TITLE}</a>
		<nav aria-label="Main">
			{
				links.map((link) => (
					<a href={link.href} class:list={{ active: link.active }} aria-current={link.active ? 'page' : undefined}>
						{link.text}
					</a>
				))
			}
		</nav>
	</div>
</header>
<style>
	.site-header {
		border-bottom: 1px solid var(--rule);
	}
	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 72px;
	}
	.wordmark {
		color: var(--ink);
		font-family: var(--font-sans);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 4px;
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 500;
	}
	nav a {
		padding: 6px 12px;
		border-radius: 999px;
		color: var(--ink);
		text-decoration: none;
	}
	nav a:hover {
		color: var(--indigo);
	}
	nav a.active {
		background: var(--indigo);
		color: var(--ground);
	}
	@media (max-width: 640px) {
		.inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
			padding-top: 16px;
			padding-bottom: 12px;
		}
		nav {
			margin-left: -12px;
		}
	}
</style>
