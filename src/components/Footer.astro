---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="site-footer">
	<div class="container inner">
		<p>© {today.getFullYear()} {SITE_TITLE}</p>
		<ul>
			<li><a href="https://oftomorrow.net">oftomorrow.net</a></li>
			<li><a href="https://byo-llm.com">byo-llm.com</a></li>
			<li><a href="/rss.xml">RSS</a></li>
		</ul>
	</div>
</footer>
<style>
	.site-footer {
		margin-top: 96px;
		border-top: 1px solid var(--rule);
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 500;
		color: var(--meta);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
		padding-top: 28px;
		padding-bottom: 40px;
	}
	p {
		margin: 0;
	}
	ul {
		display: flex;
		gap: 20px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		color: var(--indigo);
		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
</style>
