---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer class="bg-text-primary text-white py-12">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-white/60 text-sm">
          © {today.getFullYear()} {SITE_TITLE}
        </p>

        <ul class="flex items-center gap-6">
          <li>
            <a href="https://oftomorrow.net" class="text-white/70 hover:text-white transition-colors text-sm">
              oftomorrow.net
            </a>
          </li>
          <li>
            <a href="https://byo-llm.com" class="text-white/70 hover:text-white transition-colors text-sm">
              byo-llm.com
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
