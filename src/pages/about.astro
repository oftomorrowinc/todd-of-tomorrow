---
import AboutText from '../components/AboutText.astro';
import { SITE_DESCRIPTION } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title="About" description={SITE_DESCRIPTION}>
	<article class="column page">
		<h1>About</h1>
		<div class="prose"><AboutText /></div>
	</article>
</Base>

<style>
	.page {
		padding-top: 64px;
	}
	h1 {
		margin: 0 0 28px;
		font-size: 46px;
		font-weight: 600;
		line-height: 1.12;
	}
	@media (max-width: 640px) {
		.page {
			padding-top: 40px;
		}
		h1 {
			font-size: 34px;
		}
	}
</style>
